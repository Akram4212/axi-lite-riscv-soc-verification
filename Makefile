	$(MAKE) test_rv32i_regfile WAVES=1
	@mkdir -p "$(WAVE_DIR)"
	@cp dump.vcd "$(WAVE_DIR)/rv32i_regfile.vcd"
	gtkwave "$(WAVE_DIR)/rv32i_regfile.vcd"

.PHONY: wave_rv32i_decoder
