# ============================================================
# Yosys synthesis check
# ============================================================

.PHONY: synth_gpio
synth_gpio:
	yosys -p "read_verilog -sv -I$(INC_DIR) $(GPIO_RTL); synth -top gpio; stat"

# ============================================================
# Cleanup
#
# Named waveforms under waves/ are preserved intentionally.
# ============================================================

.PHONY: clean
clean::
	rm -rf sim_build
	rm -rf obj_dir
	rm -rf __pycache__
	rm -rf tb/__pycache__
	rm -rf .pytest_cache
	rm -f results.xml
	rm -f dump.vcd
	rm -f dump.fst
	rm -f dump.lxt
	rm -f *.vcd
	rm -f *.fst
	rm -f *.lxt
	rm -f *.log
	rm -f *.xml
	rm -f transcript
	rm -f *.jou
	rm -f *.wdb
	rm -f coverage.dat
	rm -f coverage.info
	rm -rf coverage_annotated
	rm -rf coverage_html
	rm -f $(FIRMWARE_DIR)/*.elf
	rm -f $(FIRMWARE_DIR)/*.bin
	rm -f $(FIRMWARE_DIR)/*.hex
	rm -f $(FIRMWARE_DIR)/*.map

# ============================================================
# Include cocotb simulator Makefile for cocotb sim/results targets
# ============================================================

ifneq ($(filter sim results.xml,$(MAKECMDGOALS)),)
include $(shell cocotb-config --makefiles)/Makefile.sim
endif
